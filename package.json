{
  "name": "dsh-wide-chat",
  "version": "0.1.0",
  "description": "Drag the chat column's right edge to widen it (520-2400px, remembered across restarts). Pure front-end, no build, no host services. DSH 网页版聊天列宽度可拖拽调节插件。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Hakuno410",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hakuno410/dsh-wide-chat.git"
  },
  "homepage": "https://github.com/Hakuno410/dsh-wide-chat#readme",
  "bugs": {
    "url": "https://github.com/Hakuno410/dsh-wide-chat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ui",
    "layout",
    "chat-width",
    "resizable",
    "聊天宽度"
  ],
  "engines": {
    "node": ">=20"
  }
}
